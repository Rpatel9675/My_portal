# Yuvantara Production Environment Variables
# Domain: https://yuvantaraventure.in

# Server Port
PORT=5000

# CORS Allowed Origin
CLIENT_ORIGIN=https://yuvantaraventure.in

# Razorpay Payment Gateway Credentials
# Get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_51H0yourKeyHere
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Gmail SMTP Email Configuration for Email OTP
# 1. Enable 2-Step Verification in Google Account
# 2. Generate App Password under Security -> App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=xyv@yuvantara.com
SMTP_PASS=your_16_char_gmail_app_password
EMAIL_FROM_NAME="Yuvantara Portal"

# Super Admin Account Credentials
ADMIN_EMAIL=admin@yuvantara.com
ADMIN_PASS=admin777

# Optional Firebase Admin SDK (if using Firestore Cloud)
# FIREBASE_PROJECT_ID=yuvantara-portal
